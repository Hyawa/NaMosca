{
  "name": "namosca-server-ts",
  "private": true,
  "version": "1.0.0",
  "description": "Backend TypeScript do jogo Na Mosca! (Hono + Node.js + PostgreSQL). Port do server/ PHP.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-cards.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-cards.ts",
    "test": "node --import tsx --test tests/unit/str.test.ts tests/unit/answer-matcher.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.6.14",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~5.7.0"
  }
}
