# ===============================
# Na Mosca! — backend TypeScript
# Copie para .env no desenvolvimento local.
# No Render, defina estes valores no painel (ou via render.yaml).
# ===============================

# Conexão com o PostgreSQL. No Render, use a Connection String do
# banco Postgres provisionado (ele já vem com sslmode=require).
# Em desenvolvimento local, deixe comentado e use as variáveis PG* abaixo.
# DATABASE_URL=postgresql://user:password@host:5432/namosca?sslmode=require

# --- Alternativa local (sem DATABASE_URL) ---------------------------
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=namosca
# PGUSER=namosca
# PGPASSWORD=namosca
# PGSSLMODE=disable

# Porta HTTP. O Render define PORT automaticamente (10000 em planos
# gratuitos); localmente use 3000.
# PORT=3000

# Origens permitidas para CORS, separadas por vírgula, ou "*" para qualquer.
# CORS_ALLOWED_ORIGINS=*

# Ambiente: local | production | ...
# APP_ENV=local

# Exibe mensagens de erro detalhadas no log/resposta quando true.
# APP_DEBUG=false
