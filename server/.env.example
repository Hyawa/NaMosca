# Copie para .env e ajuste os valores locais.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:5173
API_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=namosca
DB_TEST_NAME=namosca_test
