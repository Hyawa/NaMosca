DB_PASS=troque-esta-senha

CORS_ALLOWED_ORIGINS=http://localhost:5173

# IA (opcional — usado apenas pela geração de cartas em desenvolvimento)
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENROUTER_API_KEY=
