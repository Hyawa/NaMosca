{
  "name": "namosca/server",
  "description": "Backend PHP do jogo Na Mosca!",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-intl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12"
  },
  "autoload": {
    "psr-4": {
      "NaMosca\\": "src/",
      "NaMosca\\Scripts\\": "scripts/",
      "NaMosca\\Tests\\": "tests/"
    }
  },
  "autoload-dev": {
    "files": []
  },
  "scripts": {
    "test": "phpunit --no-coverage"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  }
}
